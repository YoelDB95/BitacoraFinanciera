    }
  },
  "type": "module",
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@prisma/orm-postgres": "8.0.0-rc.17",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "prisma": "8.0.0-rc.22",
    "temporal-polyfill": "^1.0.5"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
