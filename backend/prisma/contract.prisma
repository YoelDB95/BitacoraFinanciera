    CEDEAR = "CEDEAR"
    MUTUAL_FUND = "MUTUAL_FUND"
    FIXED_TERM = "FIXED_TERM"
    CAUCION = "CAUCION"
    OTHER = "OTHER"
    @@map("investment_type")
  }

  native_enum InvoiceStatus {
    DRAFT = "DRAFT"
