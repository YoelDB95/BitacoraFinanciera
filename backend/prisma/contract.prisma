    SENT = "SENT"
    PAID = "PAID"
    CANCELLED = "CANCELLED"
    @@map("invoice_status")
  }

  native_enum LoanMovementType {
    DISBURSEMENT = "DISBURSEMENT"
    REPAYMENT = "REPAYMENT"
    INTEREST = "INTEREST"
    ADJUSTMENT = "ADJUSTMENT"
    @@map("loan_movement_type")
  }

  native_enum LoanStatus {
    ACTIVE = "ACTIVE"
    COMPLETED = "COMPLETED"
    CANCELLED = "CANCELLED"
    @@map("loan_status")
  }

  native_enum LoanType {
    LENT = "LENT"
    BORROWED = "BORROWED"
    @@map("loan_type")
  }

  native_enum ReservationMovementType {
    ALLOCATE = "ALLOCATE"
    RELEASE = "RELEASE"
    ADJUSTMENT = "ADJUSTMENT"
    @@map("reservation_movement_type")
  }

  native_enum ReservationStatus {
    ACTIVE = "ACTIVE"
    COMPLETED = "COMPLETED"
    CANCELLED = "CANCELLED"
    @@map("reservation_status")
  }

  native_enum RouteRateType {
    PER_KILOMETER = "PER_KILOMETER"
    PER_PACKAGE = "PER_PACKAGE"
    FIXED = "FIXED"
    @@map("route_rate_type")
  }

  native_enum SyncStatus {
    STARTED = "STARTED"
