// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

namespace public {
  model Users {
    id                 BigInt               @id(map: "users_pkey") @default(autoincrement())
    name               VarChar(100)
    email              String               @unique(map: "users_email_key")
    passwordHash       VarChar(255)         @map("password_hash")
    createdAt          Timestamptz          @default(now()) @map("created_at")
    updatedAt          Timestamptz          @default(now()) @map("updated_at")
    accounts           Accounts[]
    categories         Categories[]
    investmentAccounts InvestmentAccounts[]
    tags               Tags[]

    @@rls
    @@map("users")
  }

  model Accounts {
    id                 BigInt               @id(map: "accounts_pkey") @default(autoincrement())
    userId             BigInt?              @map("user_id")
    name               VarChar(100)
    _type              pg.enum(AccountType) @map("type")
    provider           VarChar(50)?
    currency           VarChar(10)          @default("ARS")
    initialBalance     Numeric(18, 2)       @default(0) @map("initial_balance")
    isActive           Boolean              @default(true) @map("is_active")
    createdAt          Timestamptz          @default(now()) @map("created_at")
    updatedAt          Timestamptz          @default(now()) @map("updated_at")
    reservations       Reservations[]
    transactions       Transactions[]
    user               Users?               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_accounts_user", index: false)
    transfers          Transfers[]          @relation(name: "fk_transfers_from_account")
    transfersTransfers Transfers[]          @relation(name: "fk_transfers_to_account")

    @@check(expression: "(initial_balance >= (0)::numeric)", map: "chk_accounts_initial_balance")
    @@rls
    @@map("accounts")
  }

  model Categories {
    id           BigInt                @id(map: "categories_pkey") @default(autoincrement())
    userId       BigInt?               @map("user_id")
    name         VarChar(100)
    _type        pg.enum(CategoryType) @map("type")
    icon         VarChar(50)?
    parentId     BigInt?               @map("parent_id")
    createdAt    Timestamptz           @default(now()) @map("created_at")
    updatedAt    Timestamptz           @default(now()) @map("updated_at")
    transactions Transactions[]
    parent       Categories?           @relation(name: "fk_categories_parent", fields: [parentId], references: [id], onDelete: SetNull, map: "fk_categories_parent", index: false)
    categories   Categories[]          @relation(name: "fk_categories_parent")
    user         Users?                @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_categories_user", index: false)

    @@rls
    @@map("categories")
  }

  model Transactions {
    id                   BigInt                     @id(map: "transactions_pkey") @default(autoincrement())
    accountId            BigInt                     @map("account_id")
    categoryId           BigInt?                    @map("category_id")
    _type                pg.enum(TransactionType)   @map("type")
    amount               Numeric(18, 2)
    description          String?
    transactionDate      Timestamptz                @map("transaction_date")
    source               pg.enum(TransactionSource) @default("MANUAL")
    externalId           VarChar(255)?              @map("external_id")
    createdAt            Timestamptz                @default(now()) @map("created_at")
    updatedAt            Timestamptz                @default(now()) @map("updated_at")
    externalTransactions ExternalTransactions[]
    transactionTags      TransactionTags[]
    account              Accounts                   @relation(fields: [accountId], references: [id], onDelete: Restrict, map: "fk_transactions_account", index: false)
    category             Categories?                @relation(fields: [categoryId], references: [id], onDelete: SetNull, map: "fk_transactions_category", index: false)

    @@index([source, externalId], map: "uq_transactions_external", where: "(external_id IS NOT NULL)", unique: true)
    @@check(expression: "(amount > (0)::numeric)", map: "chk_transactions_amount")
    @@rls
    @@map("transactions")
  }

  model ExternalTransactions {
    id            BigInt                     @id(map: "external_transactions_pkey") @default(autoincrement())
    source        pg.enum(TransactionSource)
    externalId    VarChar(255)               @map("external_id")
    rawData       Jsonb?                     @map("raw_data")
    importedAt    Timestamptz                @default(now()) @map("imported_at")
    transactionId BigInt?                    @map("transaction_id")
    transaction   Transactions?              @relation(fields: [transactionId], references: [id], onDelete: SetNull, map: "fk_external_transaction", index: false)

    @@unique([source, externalId], map: "uq_external_transaction")
    @@rls
    @@map("external_transactions")
  }

  model InvestmentAccounts {
    id            BigInt        @id(map: "investment_accounts_pkey") @default(autoincrement())
    userId        BigInt?       @map("user_id")
    name          VarChar(100)
    provider      VarChar(100)?
    accountNumber VarChar(100)? @map("account_number")
    currency      VarChar(10)   @default("ARS")
    createdAt     Timestamptz   @default(now()) @map("created_at")
    updatedAt     Timestamptz   @default(now()) @map("updated_at")
    investments   Investments[]
    user          Users?        @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_investment_accounts_user", index: false)

    @@rls
    @@map("investment_accounts")
  }

  model Investments {
    id                     BigInt                   @id(map: "investments_pkey") @default(autoincrement())
    investmentAccountId    BigInt                   @map("investment_account_id")
    symbol                 VarChar(30)?
    name                   VarChar(100)
    _type                  VarChar(30)              @map("type")
    currency               VarChar(10)              @default("ARS")
    createdAt              Timestamptz              @default(now()) @map("created_at")
    updatedAt              Timestamptz              @default(now()) @map("updated_at")
    investmentTransactions InvestmentTransactions[]
    investmentAccount      InvestmentAccounts       @relation(fields: [investmentAccountId], references: [id], onDelete: Cascade, map: "fk_investments_account", index: false)

    @@rls
    @@map("investments")
  }

  model InvestmentTransactions {
    id              BigInt                             @id(map: "investment_transactions_pkey") @default(autoincrement())
    investmentId    BigInt                             @map("investment_id")
    _type           pg.enum(InvestmentTransactionType) @map("type")
    quantity        Numeric(18, 8)?
    price           Numeric(18, 8)?
    amount          Numeric(18, 2)
    transactionDate Timestamptz                        @map("transaction_date")
    description     String?
    createdAt       Timestamptz                        @default(now()) @map("created_at")
    investment      Investments                        @relation(fields: [investmentId], references: [id], onDelete: Cascade, map: "fk_investment_transactions_investment", index: false)

    @@check(expression: "(amount >= (0)::numeric)", map: "chk_investment_transaction_amount")
    @@check(expression: "((price IS NULL) OR (price >= (0)::numeric))", map: "chk_investment_transaction_price")
    @@check(expression: "((quantity IS NULL) OR (quantity >= (0)::numeric))", map: "chk_investment_transaction_quantity")
    @@rls
    @@map("investment_transactions")
  }

  model Reservations {
    id                   BigInt                     @id(map: "reservations_pkey") @default(autoincrement())
    accountId            BigInt                     @map("account_id")
    name                 VarChar(100)
    targetAmount         Numeric(18, 2)?            @map("target_amount")
    currentAmount        Numeric(18, 2)             @default(0) @map("current_amount")
    status               pg.enum(ReservationStatus) @default("ACTIVE")
    createdAt            Timestamptz                @default(now()) @map("created_at")
    completedAt          Timestamptz?               @map("completed_at")
    reservationMovements ReservationMovements[]
    account              Accounts                   @relation(fields: [accountId], references: [id], onDelete: Cascade, map: "fk_reservations_account", index: false)

    @@check(expression: "(current_amount >= (0)::numeric)", map: "chk_reservations_current")
    @@check(expression: "((target_amount IS NULL) OR (target_amount >= (0)::numeric))", map: "chk_reservations_target")
    @@rls
    @@map("reservations")
  }

  model ReservationMovements {
    id              BigInt                           @id(map: "reservation_movements_pkey") @default(autoincrement())
    reservationId   BigInt                           @map("reservation_id")
    _type           pg.enum(ReservationMovementType) @map("type")
    amount          Numeric(18, 2)
    description     String?
    transactionDate Timestamptz                      @map("transaction_date")
    createdAt       Timestamptz                      @default(now()) @map("created_at")
    reservation     Reservations                     @relation(fields: [reservationId], references: [id], onDelete: Cascade, map: "fk_reservation_movements_reservation", index: false)

    @@check(expression: "(amount > (0)::numeric)", map: "chk_reservation_movement_amount")
    @@rls
    @@map("reservation_movements")
  }

  model SyncLogs {
    id         BigInt                     @id(map: "sync_logs_pkey") @default(autoincrement())
    source     pg.enum(TransactionSource)
    status     pg.enum(SyncStatus)
    message    String?
    startedAt  Timestamptz                @map("started_at")
    finishedAt Timestamptz?               @map("finished_at")
    details    Jsonb?

    @@rls
    @@map("sync_logs")
  }

  model Tags {
    id              BigInt            @id(map: "tags_pkey") @default(autoincrement())
    userId          BigInt?           @map("user_id")
    name            VarChar(50)
    color           VarChar(20)?
    createdAt       Timestamptz       @default(now()) @map("created_at")
    transactionTags TransactionTags[]
    user            Users?            @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_tags_user", index: false)

    @@unique([userId, name], map: "uq_tags_user_name")
    @@rls
    @@map("tags")
  }

  model TransactionTags {
    transactionId BigInt       @map("transaction_id")
    tagId         BigInt       @map("tag_id")
    tag           Tags         @relation(fields: [tagId], references: [id], onDelete: Cascade, map: "fk_transaction_tags_tag", index: false)
    transaction   Transactions @relation(fields: [transactionId], references: [id], onDelete: Cascade, map: "fk_transaction_tags_transaction", index: false)

    @@id([transactionId, tagId], map: "transaction_tags_pkey")
    @@rls
    @@map("transaction_tags")
  }

  model Transfers {
    id              BigInt         @id(map: "transfers_pkey") @default(autoincrement())
    fromAccountId   BigInt         @map("from_account_id")
    toAccountId     BigInt         @map("to_account_id")
    amount          Numeric(18, 2)
    description     String?
    transactionDate Timestamptz    @map("transaction_date")
    createdAt       Timestamptz    @default(now()) @map("created_at")
    fromAccount     Accounts       @relation(name: "fk_transfers_from_account", fields: [fromAccountId], references: [id], onDelete: Restrict, map: "fk_transfers_from_account", index: false)
    toAccount       Accounts       @relation(name: "fk_transfers_to_account", fields: [toAccountId], references: [id], onDelete: Restrict, map: "fk_transfers_to_account", index: false)

    @@check(expression: "(amount > (0)::numeric)", map: "chk_transfer_amount")
    @@check(expression: "(from_account_id <> to_account_id)", map: "chk_transfer_different_accounts")
    @@rls
    @@map("transfers")
  }

  native_enum AccountType {
    CASH = "CASH"
    BANK = "BANK"
    WALLET = "WALLET"
    INVESTMENT = "INVESTMENT"
    CREDIT_CARD = "CREDIT_CARD"
    OTHER = "OTHER"
    @@map("account_type")
  }

  native_enum CategoryType {
    INCOME = "INCOME"
    EXPENSE = "EXPENSE"
    @@map("category_type")
  }

  native_enum InvestmentTransactionType {
    BUY = "BUY"
    SELL = "SELL"
    DIVIDEND = "DIVIDEND"
    INTEREST = "INTEREST"
    FEE = "FEE"
    TAX = "TAX"
    ADJUSTMENT = "ADJUSTMENT"
    @@map("investment_transaction_type")
  }

  native_enum ReservationMovementType {
    ALLOCATE = "ALLOCATE"
    RELEASE = "RELEASE"
    ADJUSTMENT = "ADJUSTMENT"
    @@map("reservation_movement_type")
  }

  native_enum ReservationStatus {
    ACTIVE = "ACTIVE"
    COMPLETED = "COMPLETED"
    CANCELLED = "CANCELLED"
    @@map("reservation_status")
  }

  native_enum SyncStatus {
    STARTED = "STARTED"
    SUCCESS = "SUCCESS"
    PARTIAL = "PARTIAL"
    FAILED = "FAILED"
    @@map("sync_status")
  }

  native_enum TransactionSource {
    MANUAL = "MANUAL"
    MERCADO_PAGO = "MERCADO_PAGO"
    BANK = "BANK"
    IMPORT_CSV = "IMPORT_CSV"
    SYSTEM = "SYSTEM"
    @@map("transaction_source")
  }

  native_enum TransactionType {
    INCOME = "INCOME"
    EXPENSE = "EXPENSE"
    @@map("transaction_type")
  }
}
