    PARTIAL = "PARTIAL"
    FAILED = "FAILED"
    @@map("sync_status")
  }

  native_enum TransactionSource {
    MANUAL = "MANUAL"
    MERCADO_PAGO = "MERCADO_PAGO"
    BANK = "BANK"
    IMPORT_CSV = "IMPORT_CSV"
    SYSTEM = "SYSTEM"
    @@map("transaction_source")
  }

  native_enum TransactionType {
    INCOME = "INCOME"
    EXPENSE = "EXPENSE"
    @@map("transaction_type")
  }
}
