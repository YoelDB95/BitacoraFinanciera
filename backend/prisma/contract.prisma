// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

namespace public {
  model Users {
    id                 Uuid                 @id(map: "users_pkey") @default(sql`gen_random_uuid()`)
    createdAt          Timestamptz          @default(now()) @map("created_at")
    email              String               @unique(map: "users_email_key")
    name               VarChar
    passwordHash       VarChar              @map("password_hash")
    updatedAt          Timestamptz          @default(now()) @map("updated_at")
    accounts           Accounts[]
    categories         Categories[]
    companies          Companies[]
    investmentAccounts InvestmentAccounts[]
    invoices           Invoices[]
    people             People[]
    routes             Routes[]
    tags               Tags[]

    @@rls
    @@map("users")
  }

  model Accounts {
    id                 Uuid                 @id(map: "accounts_pkey") @default(sql`gen_random_uuid()`)
    createdAt          Timestamptz          @default(now()) @map("created_at")
    currency           VarChar              @default("ARS")
    initialBalance     Numeric              @default(0) @map("initial_balance")
    isActive           Boolean              @default(true) @map("is_active")
    name               VarChar
    provider           VarChar?
    _type              pg.enum(AccountType) @map("type")
    updatedAt          Timestamptz          @default(now()) @map("updated_at")
    userId             Uuid?                @map("user_id")
    creditCardPayments CreditCardPayments[]
    creditCards        CreditCards?
    loanMovements      LoanMovements[]
    reservations       Reservations[]
    transactions       Transactions[]
    user               Users?               @relation(fields: [userId], references: [id], map: "fk_accounts_user", index: false)
    transfers          Transfers[]          @relation(name: "fk_transfers_from_account")
    transfersTransfers Transfers[]          @relation(name: "fk_transfers_to_account")

    @@check(expression: "(initial_balance >= (0)::numeric)", map: "accounts_initial_balance_check")
    @@rls
    @@map("accounts")
  }

  model CreditCards {
    id                 Uuid                 @id(map: "credit_cards_pkey") @default(sql`gen_random_uuid()`)
    accountId          Uuid                 @unique(map: "credit_cards_account_id_key") @map("account_id")
    cardBrand          String               @map("card_brand")
    closingDay         SmallInt?            @map("closing_day")
    createdAt          Timestamptz          @default(now()) @map("created_at")
    creditLimit        Numeric?             @map("credit_limit")
    dueDay             SmallInt?            @map("due_day")
    issuer             String
    lastFourDigits     VarChar?             @map("last_four_digits")
    updatedAt          Timestamptz          @default(now()) @map("updated_at")
    cardPurchases      CardPurchases[]
    creditCardPayments CreditCardPayments[]
    account            Accounts             @relation(fields: [accountId], references: [id], map: "fk_credit_cards_account")

    @@check(expression: "((closing_day >= 1) AND (closing_day <= 31))", map: "credit_cards_closing_day_check")
    @@check(expression: "((credit_limit IS NULL) OR (credit_limit >= (0)::numeric))", map: "credit_cards_credit_limit_check")
    @@check(expression: "((due_day >= 1) AND (due_day <= 31))", map: "credit_cards_due_day_check")
    @@check(expression: "((last_four_digits IS NULL) OR ((last_four_digits)::text ~ '^[0-9]{4}$'::text))", map: "credit_cards_last_four_digits_check")
    @@rls
    @@map("credit_cards")
  }

  model Categories {
    id           Uuid                  @id(map: "categories_pkey") @default(sql`gen_random_uuid()`)
    createdAt    Timestamptz           @default(now()) @map("created_at")
    icon         VarChar?
    name         VarChar
    parentId     Uuid?                 @map("parent_id")
    _type        pg.enum(CategoryType) @map("type")
    updatedAt    Timestamptz           @default(now()) @map("updated_at")
    userId       Uuid?                 @map("user_id")
    transactions Transactions[]
    parent       Categories?           @relation(name: "fk_categories_parent", fields: [parentId], references: [id], map: "fk_categories_parent", index: false)
    categories   Categories[]          @relation(name: "fk_categories_parent")
    user         Users?                @relation(fields: [userId], references: [id], map: "fk_categories_user", index: false)

    @@rls
    @@map("categories")
  }

  model Transactions {
    id                   Uuid                       @id(map: "transactions_pkey") @default(sql`gen_random_uuid()`)
    accountId            Uuid                       @map("account_id")
    amount               Numeric
    categoryId           Uuid?                      @map("category_id")
    createdAt            Timestamptz                @default(now()) @map("created_at")
    description          String?
    externalId           VarChar?                   @map("external_id")
    source               pg.enum(TransactionSource) @default("MANUAL")
    transactionDate      Timestamptz                @map("transaction_date")
    _type                pg.enum(TransactionType)   @map("type")
    updatedAt            Timestamptz                @default(now()) @map("updated_at")
    cardPurchases        CardPurchases[]
    externalTransactions ExternalTransactions[]
    transactionTags      TransactionTags[]
    account              Accounts                   @relation(fields: [accountId], references: [id], map: "fk_transactions_account", index: false)
    category             Categories?                @relation(fields: [categoryId], references: [id], map: "fk_transactions_category", index: false)

    @@check(expression: "(amount > (0)::numeric)", map: "transactions_amount_check")
    @@rls
    @@map("transactions")
  }

  model CardPurchases {
    id                Uuid               @id(map: "card_purchases_pkey") @default(sql`gen_random_uuid()`)
    createdAt         Timestamptz        @default(now()) @map("created_at")
    creditCardId      Uuid               @map("credit_card_id")
    description       String
    installmentsCount Int                @default(1) @map("installments_count")
    interestAmount    Numeric            @default(0) @map("interest_amount")
    principalAmount   Numeric            @map("principal_amount")
    purchaseDate      Date               @map("purchase_date")
    totalAmount       Numeric            @map("total_amount")
    transactionId     Uuid?              @map("transaction_id")
    updatedAt         Timestamptz        @default(now()) @map("updated_at")
    cardInstallments  CardInstallments[]
    creditCard        CreditCards        @relation(fields: [creditCardId], references: [id], map: "fk_card_purchases_card", index: false)
    transaction       Transactions?      @relation(fields: [transactionId], references: [id], map: "fk_card_purchases_transaction", index: false)

    @@check(expression: "(installments_count > 0)", map: "card_purchases_installments_count_check")
    @@check(expression: "(interest_amount >= (0)::numeric)", map: "card_purchases_interest_amount_check")
    @@check(expression: "(principal_amount >= (0)::numeric)", map: "card_purchases_principal_amount_check")
    @@check(expression: "(total_amount > (0)::numeric)", map: "card_purchases_total_amount_check")
    @@rls
    @@map("card_purchases")
  }

  model CardInstallments {
    id                     Uuid                           @id(map: "card_installments_pkey") @default(sql`gen_random_uuid()`)
    amount                 Numeric
    cardPurchaseId         Uuid                           @map("card_purchase_id")
    createdAt              Timestamptz                    @default(now()) @map("created_at")
    dueDate                Date                           @map("due_date")
    installmentNumber      Int                            @map("installment_number")
    paidAt                 Timestamptz?                   @map("paid_at")
    status                 pg.enum(CardInstallmentStatus) @default("PENDING")
    updatedAt              Timestamptz                    @default(now()) @map("updated_at")
    cardPaymentAllocations CardPaymentAllocations[]
    cardPurchase           CardPurchases                  @relation(fields: [cardPurchaseId], references: [id], map: "fk_card_installments_purchase", index: false)

    @@check(expression: "(amount > (0)::numeric)", map: "card_installments_amount_check")
    @@check(expression: "(installment_number > 0)", map: "card_installments_installment_number_check")
    @@rls
    @@map("card_installments")
  }

  model CreditCardPayments {
    id                     Uuid                     @id(map: "credit_card_payments_pkey") @default(sql`gen_random_uuid()`)
    accountId              Uuid                     @map("account_id")
    amount                 Numeric
    createdAt              Timestamptz              @default(now()) @map("created_at")
    creditCardId           Uuid                     @map("credit_card_id")
    description            String?
    paymentDate            Date                     @map("payment_date")
    cardPaymentAllocations CardPaymentAllocations[]
    account                Accounts                 @relation(fields: [accountId], references: [id], map: "fk_credit_card_payments_account", index: false)
    creditCard             CreditCards              @relation(fields: [creditCardId], references: [id], map: "fk_credit_card_payments_card", index: false)

    @@check(expression: "(amount > (0)::numeric)", map: "credit_card_payments_amount_check")
    @@rls
    @@map("credit_card_payments")
  }

  model CardPaymentAllocations {
    amount        Numeric
    installmentId Uuid               @map("installment_id")
    paymentId     Uuid               @map("payment_id")
    installment   CardInstallments   @relation(fields: [installmentId], references: [id], map: "fk_card_payment_allocations_installment", index: false)
    payment       CreditCardPayments @relation(fields: [paymentId], references: [id], map: "fk_card_payment_allocations_payment", index: false)

    @@id([paymentId, installmentId], map: "card_payment_allocations_pkey")
    @@check(expression: "(amount > (0)::numeric)", map: "card_payment_allocations_amount_check")
    @@rls
    @@map("card_payment_allocations")
  }

  model Companies {
    id                     Uuid                     @id(map: "companies_pkey") @default(sql`gen_random_uuid()`)
    active                 Boolean                  @default(true)
    billingAddress         String?                  @map("billing_address")
    billingNotes           String?                  @map("billing_notes")
    businessName           String?                  @map("business_name")
    createdAt              Timestamptz              @default(now()) @map("created_at")
    cuit                   VarChar
    legalName              String                   @map("legal_name")
    updatedAt              Timestamptz              @default(now()) @map("updated_at")
    userId                 Uuid?                    @map("user_id")
    companyBillingContacts CompanyBillingContacts[]
    companyRates           CompanyRates[]
    invoices               Invoices[]
    routeCompanies         RouteCompanies[]
    user                   Users?                   @relation(fields: [userId], references: [id], map: "fk_companies_user", index: false)

    @@rls
    @@map("companies")
  }

  model CompanyBillingContacts {
    id        Uuid        @id(map: "company_billing_contacts_pkey") @default(sql`gen_random_uuid()`)
    companyId Uuid        @map("company_id")
    createdAt Timestamptz @default(now()) @map("created_at")
    email     String
    isPrimary Boolean     @default(false) @map("is_primary")
    name      String
    notes     String?
    updatedAt Timestamptz @default(now()) @map("updated_at")
    company   Companies   @relation(fields: [companyId], references: [id], map: "fk_company_billing_contacts_company", index: false)

    @@rls
    @@map("company_billing_contacts")
  }

  model CompanyRates {
    id             Uuid             @id(map: "company_rates_pkey") @default(sql`gen_random_uuid()`)
    amount         Numeric
    companyId      Uuid             @map("company_id")
    createdAt      Timestamptz      @default(now()) @map("created_at")
    name           VarChar
    notes          String?
    unit           VarChar
    updatedAt      Timestamptz      @default(now()) @map("updated_at")
    validFrom      Date             @map("valid_from")
    validTo        Date?            @map("valid_to")
    routeCompanies RouteCompanies[]
    company        Companies        @relation(fields: [companyId], references: [id], map: "fk_company_rates_company", index: false)

    @@check(expression: "(amount > (0)::numeric)", map: "company_rates_amount_check")
    @@rls
    @@map("company_rates")
  }

  model ExternalTransactions {
    id            Uuid                       @id(map: "external_transactions_pkey") @default(sql`gen_random_uuid()`)
    externalId    VarChar                    @map("external_id")
    importedAt    Timestamptz                @default(now()) @map("imported_at")
    rawData       Jsonb?                     @map("raw_data")
    source        pg.enum(TransactionSource)
    transactionId Uuid?                      @map("transaction_id")
    transaction   Transactions?              @relation(fields: [transactionId], references: [id], map: "fk_external_transaction", index: false)

    @@rls
    @@map("external_transactions")
  }

  model InvestmentAccounts {
    id            Uuid          @id(map: "investment_accounts_pkey") @default(sql`gen_random_uuid()`)
    accountNumber VarChar?      @map("account_number")
    createdAt     Timestamptz   @default(now()) @map("created_at")
    currency      VarChar       @default("ARS")
    name          VarChar
    provider      VarChar?
    updatedAt     Timestamptz   @default(now()) @map("updated_at")
    userId        Uuid?         @map("user_id")
    investments   Investments[]
    user          Users?        @relation(fields: [userId], references: [id], map: "fk_investment_accounts_user", index: false)

    @@rls
    @@map("investment_accounts")
  }

  model Investments {
    id                     Uuid                     @id(map: "investments_pkey") @default(sql`gen_random_uuid()`)
    createdAt              Timestamptz              @default(now()) @map("created_at")
    currency               VarChar                  @default("ARS")
    investmentAccountId    Uuid                     @map("investment_account_id")
    name                   VarChar
    symbol                 VarChar?
    _type                  pg.enum(InvestmentType)  @map("type")
    updatedAt              Timestamptz              @default(now()) @map("updated_at")
    investmentTransactions InvestmentTransactions[]
    investmentAccount      InvestmentAccounts       @relation(fields: [investmentAccountId], references: [id], map: "fk_investments_account", index: false)

    @@rls
    @@map("investments")
  }

  model InvestmentTransactions {
    id              Uuid                               @id(map: "investment_transactions_pkey") @default(sql`gen_random_uuid()`)
    amount          Numeric
    createdAt       Timestamptz                        @default(now()) @map("created_at")
    description     String?
    investmentId    Uuid                               @map("investment_id")
    price           Numeric?
    quantity        Numeric?
    transactionDate Timestamptz                        @map("transaction_date")
    _type           pg.enum(InvestmentTransactionType) @map("type")
    investment      Investments                        @relation(fields: [investmentId], references: [id], map: "fk_investment_transactions_investment", index: false)

    @@check(expression: "(amount >= (0)::numeric)", map: "investment_transactions_amount_check")
    @@check(expression: "((price IS NULL) OR (price >= (0)::numeric))", map: "investment_transactions_price_check")
    @@check(expression: "((quantity IS NULL) OR (quantity >= (0)::numeric))", map: "investment_transactions_quantity_check")
    @@rls
    @@map("investment_transactions")
  }

  model Invoices {
    id                    Uuid                    @id(map: "invoices_pkey") @default(sql`gen_random_uuid()`)
    companyId             Uuid                    @map("company_id")
    createdAt             Timestamptz             @default(now()) @map("created_at")
    invoiceDate           Date                    @map("invoice_date")
    invoiceNumber         String?                 @map("invoice_number")
    notes                 String?
    paidAt                Timestamptz?            @map("paid_at")
    periodMonth           SmallInt                @map("period_month")
    periodYear            SmallInt                @map("period_year")
    sentAt                Timestamptz?            @map("sent_at")
    status                pg.enum(InvoiceStatus)  @default("DRAFT")
    subtotal              Numeric
    total                 Numeric
    updatedAt             Timestamptz             @default(now()) @map("updated_at")
    userId                Uuid                    @map("user_id")
    invoiceRouteCompanies InvoiceRouteCompanies[]
    company               Companies               @relation(fields: [companyId], references: [id], map: "fk_invoices_company", index: false)
    user                  Users                   @relation(fields: [userId], references: [id], map: "fk_invoices_user", index: false)

    @@check(expression: "((period_month >= 1) AND (period_month <= 12))", map: "invoices_period_month_check")
    @@check(expression: "(subtotal >= (0)::numeric)", map: "invoices_subtotal_check")
    @@check(expression: "(total >= (0)::numeric)", map: "invoices_total_check")
    @@rls
    @@map("invoices")
  }

  model RouteTypes {
    id         Uuid         @id(map: "route_types_pkey") @default(sql`gen_random_uuid()`)
    code       VarChar      @unique(map: "route_types_code_key")
    createdAt  Timestamptz  @default(now()) @map("created_at")
    isActive   Boolean      @default(true) @map("is_active")
    isSpecial  Boolean      @default(false) @map("is_special")
    name       VarChar
    updatedAt  Timestamptz  @default(now()) @map("updated_at")
    routeRates RouteRates[]
    routes     Routes[]

    @@rls
    @@map("route_types")
  }

  model RouteRates {
    id             Uuid             @id(map: "route_rates_pkey") @default(sql`gen_random_uuid()`)
    amount         Numeric
    createdAt      Timestamptz      @default(now()) @map("created_at")
    notes          String?
    routeTypeId    Uuid?            @map("route_type_id")
    updatedAt      Timestamptz      @default(now()) @map("updated_at")
    validFrom      Date             @map("valid_from")
    validTo        Date?            @map("valid_to")
    routeCompanies RouteCompanies[]
    routes         Routes[]
    routeType      RouteTypes?      @relation(fields: [routeTypeId], references: [id], map: "fk_route_rates_route_type", index: false)

    @@check(expression: "(amount >= (0)::numeric)", map: "route_rates_amount_check")
    @@rls
    @@map("route_rates")
  }

  model Routes {
    id                  Uuid             @id(map: "routes_pkey") @default(sql`gen_random_uuid()`)
    createdAt           Timestamptz      @default(now()) @map("created_at")
    destinationCity     String           @map("destination_city")
    kilometers          Numeric
    notes               String?
    packagesUndelivered Int              @default(0) @map("packages_undelivered")
    routeCode           String           @map("route_code")
    routeDate           Date             @map("route_date")
    routeRateId         Uuid?            @map("route_rate_id")
    routeTypeId         Uuid?            @map("route_type_id")
    updatedAt           Timestamptz      @default(now()) @map("updated_at")
    userId              Uuid?            @map("user_id")
    vehicleKmEnd        Numeric          @map("vehicle_km_end")
    vehicleKmStart      Numeric          @map("vehicle_km_start")
    routeCompanies      RouteCompanies[]
    routeRate           RouteRates?      @relation(fields: [routeRateId], references: [id], map: "fk_routes_route_rate", index: false)
    routeType           RouteTypes?      @relation(fields: [routeTypeId], references: [id], map: "fk_routes_route_type", index: false)
    user                Users?           @relation(fields: [userId], references: [id], map: "fk_routes_user", index: false)

    @@check(expression: "(vehicle_km_end >= vehicle_km_start)", map: "check_route_kilometers")
    @@check(expression: "(kilometers >= (0)::numeric)", map: "routes_kilometers_check")
    @@check(expression: "(packages_undelivered >= 0)", map: "routes_packages_undelivered_check")
    @@check(expression: "(vehicle_km_end >= (0)::numeric)", map: "routes_vehicle_km_end_check")
    @@check(expression: "(vehicle_km_start >= (0)::numeric)", map: "routes_vehicle_km_start_check")
    @@rls
    @@map("routes")
  }

  model RouteCompanies {
    id                    Uuid                    @id(map: "route_companies_pkey") @default(sql`gen_random_uuid()`)
    billingAmount         Numeric?                @map("billing_amount")
    companyId             Uuid                    @map("company_id")
    companyRateAmount     Numeric?                @map("company_rate_amount")
    companyRateId         Uuid?                   @map("company_rate_id")
    createdAt             Timestamptz             @default(now()) @map("created_at")
    kilometers            Numeric?
    notes                 String?
    packagesReceived      Int                     @default(0) @map("packages_received")
    packagesUndelivered   Int                     @default(0) @map("packages_undelivered")
    rateAmount            Numeric?                @map("rate_amount")
    routeId               Uuid                    @map("route_id")
    routeRateAmount       Numeric?                @map("route_rate_amount")
    routeRateId           Uuid?                   @map("route_rate_id")
    updatedAt             Timestamptz             @default(now()) @map("updated_at")
    invoiceRouteCompanies InvoiceRouteCompanies[]
    company               Companies               @relation(fields: [companyId], references: [id], map: "fk_route_companies_company", index: false)
    companyRate           CompanyRates?           @relation(fields: [companyRateId], references: [id], map: "fk_route_companies_company_rate", index: false)
    route                 Routes                  @relation(fields: [routeId], references: [id], map: "fk_route_companies_route", index: false)
    routeRate             RouteRates?             @relation(fields: [routeRateId], references: [id], map: "fk_route_companies_route_rate", index: false)

    @@check(expression: "((billing_amount IS NULL) OR (billing_amount >= (0)::numeric))", map: "route_companies_billing_amount_check")
    @@check(expression: "((kilometers IS NULL) OR (kilometers >= (0)::numeric))", map: "route_companies_kilometers_check")
    @@check(expression: "(packages_received >= 0)", map: "route_companies_packages_received_check")
    @@check(expression: "(packages_undelivered >= 0)", map: "route_companies_packages_undelivered_check")
    @@check(expression: "((rate_amount IS NULL) OR (rate_amount >= (0)::numeric))", map: "route_companies_rate_amount_check")
    @@rls
    @@map("route_companies")
  }

  model InvoiceRouteCompanies {
    amount         Numeric
    invoiceId      Uuid           @map("invoice_id")
    routeCompanyId Uuid           @map("route_company_id")
    invoice        Invoices       @relation(fields: [invoiceId], references: [id], map: "fk_invoice_route_companies_invoice", index: false)
    routeCompany   RouteCompanies @relation(fields: [routeCompanyId], references: [id], map: "fk_invoice_route_companies_route_company", index: false)

    @@id([invoiceId, routeCompanyId], map: "invoice_route_companies_pkey")
    @@check(expression: "(amount >= (0)::numeric)", map: "invoice_route_companies_amount_check")
    @@rls
    @@map("invoice_route_companies")
  }

  model People {
    id        Uuid        @id(map: "people_pkey") @default(sql`gen_random_uuid()`)
    createdAt Timestamptz @default(now()) @map("created_at")
    name      String
    notes     String?
    updatedAt Timestamptz @default(now()) @map("updated_at")
    userId    Uuid?       @map("user_id")
    loans     Loans[]
    user      Users?      @relation(fields: [userId], references: [id], map: "fk_people_user", index: false)

    @@rls
    @@map("people")
  }

  model Loans {
    id                             Uuid                @id(map: "loans_pkey") @default(sql`gen_random_uuid()`)
    createdAt                      Timestamptz         @default(now()) @map("created_at")
    description                    String?
    dueDate                        Date?               @map("due_date")
    outstandingAmount              Numeric             @map("outstanding_amount")
    personId                       Uuid                @map("person_id")
    principalAmount                Numeric             @map("principal_amount")
    startDate                      Date                @map("start_date")
    status                         pg.enum(LoanStatus) @default("ACTIVE")
    _type                          pg.enum(LoanType)   @map("type")
    updatedAt                      Timestamptz         @default(now()) @map("updated_at")
    loanMovements                  LoanMovements[]
    loanSettlements                LoanSettlements[]   @relation(name: "fk_loan_settlements_payable")
    loanSettlementsLoanSettlements LoanSettlements[]   @relation(name: "fk_loan_settlements_receivable")
    person                         People              @relation(fields: [personId], references: [id], map: "fk_loans_person", index: false)

    @@check(expression: "(outstanding_amount >= (0)::numeric)", map: "loans_outstanding_amount_check")
    @@check(expression: "(principal_amount > (0)::numeric)", map: "loans_principal_amount_check")
    @@rls
    @@map("loans")
  }

  model LoanMovements {
    id              Uuid                      @id(map: "loan_movements_pkey") @default(sql`gen_random_uuid()`)
    accountId       Uuid?                     @map("account_id")
    amount          Numeric
    createdAt       Timestamptz               @default(now()) @map("created_at")
    description     String?
    loanId          Uuid                      @map("loan_id")
    transactionDate Date                      @map("transaction_date")
    _type           pg.enum(LoanMovementType) @map("type")
    account         Accounts?                 @relation(fields: [accountId], references: [id], map: "fk_loan_movements_account", index: false)
    loan            Loans                     @relation(fields: [loanId], references: [id], map: "fk_loan_movements_loan", index: false)

    @@check(expression: "(amount > (0)::numeric)", map: "loan_movements_amount_check")
    @@rls
    @@map("loan_movements")
  }

  model LoanSettlements {
    id               Uuid        @id(map: "loan_settlements_pkey") @default(sql`gen_random_uuid()`)
    amount           Numeric
    createdAt        Timestamptz @default(now()) @map("created_at")
    description      String?
    payableLoanId    Uuid        @map("payable_loan_id")
    receivableLoanId Uuid        @map("receivable_loan_id")
    settlementDate   Date        @map("settlement_date")
    payableLoan      Loans       @relation(name: "fk_loan_settlements_payable", fields: [payableLoanId], references: [id], map: "fk_loan_settlements_payable", index: false)
    receivableLoan   Loans       @relation(name: "fk_loan_settlements_receivable", fields: [receivableLoanId], references: [id], map: "fk_loan_settlements_receivable", index: false)

    @@check(expression: "(amount > (0)::numeric)", map: "loan_settlements_amount_check")
    @@rls
    @@map("loan_settlements")
  }

  model Reservations {
    id                   Uuid                       @id(map: "reservations_pkey") @default(sql`gen_random_uuid()`)
    accountId            Uuid                       @map("account_id")
    completedAt          Timestamptz?               @map("completed_at")
    createdAt            Timestamptz                @default(now()) @map("created_at")
    currentAmount        Numeric                    @default(0) @map("current_amount")
    name                 VarChar
    status               pg.enum(ReservationStatus) @default("ACTIVE")
    targetAmount         Numeric?                   @map("target_amount")
    reservationMovements ReservationMovements[]
    account              Accounts                   @relation(fields: [accountId], references: [id], map: "fk_reservations_account", index: false)

    @@check(expression: "(current_amount >= (0)::numeric)", map: "reservations_current_amount_check")
    @@check(expression: "((target_amount IS NULL) OR (target_amount >= (0)::numeric))", map: "reservations_target_amount_check")
    @@rls
    @@map("reservations")
  }

  model ReservationMovements {
    id              Uuid                             @id(map: "reservation_movements_pkey") @default(sql`gen_random_uuid()`)
    amount          Numeric
    createdAt       Timestamptz                      @default(now()) @map("created_at")
    description     String?
    reservationId   Uuid                             @map("reservation_id")
    transactionDate Timestamptz                      @map("transaction_date")
    _type           pg.enum(ReservationMovementType) @map("type")
    reservation     Reservations                     @relation(fields: [reservationId], references: [id], map: "fk_reservation_movements_reservation", index: false)

    @@check(expression: "(amount > (0)::numeric)", map: "reservation_movements_amount_check")
    @@rls
    @@map("reservation_movements")
  }

  model SyncLogs {
    id         Uuid                       @id(map: "sync_logs_pkey") @default(sql`gen_random_uuid()`)
    details    Jsonb?
    finishedAt Timestamptz?               @map("finished_at")
    message    String?
    source     pg.enum(TransactionSource)
    startedAt  Timestamptz                @map("started_at")
    status     pg.enum(SyncStatus)

    @@rls
    @@map("sync_logs")
  }

  model Tags {
    id              Uuid              @id(map: "tags_pkey") @default(sql`gen_random_uuid()`)
    color           VarChar?
    createdAt       Timestamptz       @default(now()) @map("created_at")
    name            VarChar
    userId          Uuid?             @map("user_id")
    transactionTags TransactionTags[]
    user            Users?            @relation(fields: [userId], references: [id], map: "fk_tags_user", index: false)

    @@rls
    @@map("tags")
  }

  model TransactionTags {
    tagId         Uuid         @map("tag_id")
    transactionId Uuid         @map("transaction_id")
    tag           Tags         @relation(fields: [tagId], references: [id], map: "fk_transaction_tags_tag", index: false)
    transaction   Transactions @relation(fields: [transactionId], references: [id], map: "fk_transaction_tags_transaction", index: false)

    @@id([transactionId, tagId], map: "transaction_tags_pkey")
    @@rls
    @@map("transaction_tags")
  }

  model Transfers {
    id              Uuid        @id(map: "transfers_pkey") @default(sql`gen_random_uuid()`)
    amount          Numeric
    createdAt       Timestamptz @default(now()) @map("created_at")
    description     String?
    fromAccountId   Uuid        @map("from_account_id")
    toAccountId     Uuid        @map("to_account_id")
    transactionDate Timestamptz @map("transaction_date")
    fromAccount     Accounts    @relation(name: "fk_transfers_from_account", fields: [fromAccountId], references: [id], map: "fk_transfers_from_account", index: false)
    toAccount       Accounts    @relation(name: "fk_transfers_to_account", fields: [toAccountId], references: [id], map: "fk_transfers_to_account", index: false)

    @@check(expression: "(amount > (0)::numeric)", map: "transfers_amount_check")
    @@rls
    @@map("transfers")
  }

  native_enum AccountType {
    CASH = "CASH"
    BANK = "BANK"
    WALLET = "WALLET"
    INVESTMENT = "INVESTMENT"
    CREDIT_CARD = "CREDIT_CARD"
    OTHER = "OTHER"
    @@map("account_type")
  }

